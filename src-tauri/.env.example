# Rewards contract for each network. Compiled in at build time, including mobile.
# Rebuild every node after changing them. Leave empty to charge no fee.
CABALMESH_REWARDS_TESTNET=rewards.cabalmesh.testnet
# No effect while fee_per_side is 0 on mainnet. See docs/near-contract-deploy.md.
CABALMESH_REWARDS_MAINNET=

# Desktop only, read when the app starts. Leave empty to use the built-in values.
CABALMESH_NETWORK=
NEAR_RPC_URL=
NEAR_VERIFIER=
