{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Main window on desktop. core:default already bundles app/event/image/menu/path/resources/tray/webview/window, so listing its members alongside it would be redundant rather than least privilege. App command permissions are generated from the COMMANDS list in build.rs \u2014 see capabilities/README.md. Desktop and mobile now share one frontend and one handler in lib.rs, so this grants exactly the same command set as mobile.json.",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-ble-status",
    "allow-broadcast-intent",
    "allow-cancel-intent",
    "allow-enter-mesh",
    "allow-guardian-approve-unlock",
    "allow-guardian-candidates",
    "allow-guardian-deny-unlock",
    "allow-guardian-enroll",
    "allow-guardian-request-unlock",
    "allow-guardian-status",
    "allow-intent-detail",
    "allow-intent-form-options",
    "allow-intent-proof",
    "allow-list-intents",
    "allow-list-nearby-nodes",
    "allow-mesh-snapshot",
    "allow-llm-get-settings",
    "allow-llm-save-settings",
    "allow-llm-set-api-key",
    "allow-llm-test-connection",
    "allow-network-set",
    "allow-parse-intent-chat",
    "allow-preview-intent",
    "allow-profile-summary",
    "allow-security-disable-passphrase",
    "allow-security-enable-passphrase",
    "allow-security-status",
    "allow-security-unlock",
    "allow-session-status",
    "allow-set-offline-mode",
    "allow-settle-intent",
    "allow-subscribe-mesh-log",
    "allow-subscribe-settlement-log",
    "allow-unsubscribe",
    "allow-vault-address",
    "allow-near-account",
    "allow-wallet-setup-status",
    "allow-wallet-check-name",
    "allow-wallet-create-testnet-account",
    "allow-near-deposit",
    "allow-near-withdraw",
    "allow-vault-assets",
    "allow-vault-refresh-balance",
    "allow-vault-export-key",
    "allow-vault-identities",
    "allow-vault-import-key",
    "allow-vault-keys"
  ]
}
